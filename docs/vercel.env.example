# Variables para Vercel — copiar en Project Settings → Environment Variables.
# No subas este archivo con valores reales al repositorio.
# Guía completa: docs/vercel.md

# ---- Obligatorias ----
DATABASE_URL=postgresql+psycopg2://usuario:clave@host:puerto/base?sslmode=require
JWT_SECRET=genera_uno_con_python_-c_import_secrets_print_secrets.token_urlsafe(48)

# Dominio público (para CORS y enlaces). Si usas dominio propio, cámbialo.
CORS_ORIGINS=https://tu-proyecto.vercel.app

# ---- Pool de Postgres (recomendado en Vercel) ----
# Vercel crea muchas instancias; un pool grande agota las conexiones del plan.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10

# ---- Redis (opcional) ----
# Sin Redis: 2FA/códigos usan Postgres y WhatsApp no puede vincular números.
#REDIS_URL=rediss://default:clave@host.upstash.io:6379

# ---- Email 2FA (opcional, pero necesario para 2FA y recuperar contraseña) ----
# Vercel bloquea el puerto 25: usa 465 o 587.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=tu_correo@gmail.com
#SMTP_PASSWORD=contraseña_de_aplicación
#SMTP_FROM=CTD <no-reply@tudominio.com>

# ---- IA: asesor, captura y voz (opcional) ----
# Groq: https://api.groq.com/openai/v1 + openai/gpt-oss-20b
# OpenAI: https://api.openai.com/v1 + gpt-4o-mini
#OPENAI_API_KEY=
#ASESOR_BASE_URL=https://api.groq.com/openai/v1
#ASESOR_MODEL=openai/gpt-oss-20b
#VOZ_MODEL=whisper-large-v3-turbo
# No bajes ASESOR_REASONING_EFFORT a low para captura.

# Vercel rechaza cuerpos > 4.5 MB; deja margen para el multipart.
VOZ_MAX_BYTES=4000000

# ---- Wompi (opcional; sin esto el cobro queda deshabilitado) ----
#WOMPI_PUBLIC_KEY=
#WOMPI_EVENTS_SECRET=
#WOMPI_ENLACE_PRO=
#PRO_PRECIO_MES=15000

# ---- WhatsApp Cloud API de Meta (opcional; el bot queda dormido sin esto) ----
#WHATSAPP_TOKEN=
#WHATSAPP_PHONE_ID=
#WHATSAPP_VERIFY_TOKEN=
#WHATSAPP_APP_SECRET=

# ---- Migraciones en Preview (opcional) ----
# Un Preview NO migra por defecto. Actívalo solo contra una base de preview.
#RUN_MIGRATIONS=0
