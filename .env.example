POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas_dev
POSTGRES_DB=finanzas
POSTGRES_PORT=5432
API_PORT=8000

# OBLIGATORIO: sin esto la app NO ARRANCA (ver core/config.py).
# Con el valor de ejemplo, cualquiera que lo lea en este repositorio puede firmar
# un token con cualquier user_id y entrar como ese usuario.
# Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotarlo cierra todas las sesiones abiertas.
JWT_SECRET=genera_uno_real_aqui_minimo_32_chars

# --- Postgres externo (Aiven). Tiene prioridad sobre POSTGRES_* local ---
# Copia el Service URI de Aiven y cambia postgres:// por postgresql+psycopg2://
# Asegura ?sslmode=require al final.
# Ejemplo:
# DATABASE_URL=postgresql+psycopg2://avnadmin:TU_PASSWORD@pg-xxx.aivencloud.com:16434/defaultdb?sslmode=require
# --- Redis (códigos temporales 2FA). En compose ya apunta al servicio local ---
#REDIS_URL=redis://redis:6379/0
# --- Email 2FA (Gmail: usa contraseña de aplicación, no la normal) ---
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=tu_correo@gmail.com
#SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# --- Asesor IA (plan separado). Sin clave → 503 explicativo ---
# OpenAI: OPENAI_API_KEY=sk-...  (ASESOR_MODEL=gpt-4o-mini)
# Groq gratis (recomendado para probar): key en console.groq.com
# Modelos vigentes (ver /models): openai/gpt-oss-20b (rápido) u openai/gpt-oss-120b
# La captura de texto/voz usará gpt-oss-20b con function calling (pendiente).
# NO bajes ASESOR_REASONING_EFFORT a "low" para capturar: medido, se equivoca en
# el metodo de pago y en la categoria (dijo "Efectivo" cuando el texto decia "Nequi").
#OPENAI_API_KEY=gsk_...
#ASESOR_BASE_URL=https://api.groq.com/openai/v1
#ASESOR_MODEL=openai/gpt-oss-20b
# Ollama local: ASESOR_BASE_URL=http://host.docker.internal:11434/v1  ASESOR_MODEL=llama3.1
#OPENAI_API_KEY=
#DATABASE_URL=
